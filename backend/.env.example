# Run: python scripts/init_env.py (generates your own secret in .env)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./data/plantlight.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Exact web frontend origins; Android native apps do not need CORS.
CORS_ORIGINS=[]

# Increase whenever the configured light algorithm behavior/model changes.
DLI_CACHE_VERSION=3206220-v5

# Bundled algorithm commit 320622063cc465f669b2548ad33f9f487adf51de
DLI_CALLABLE=grid_dli_service:compute_room_dli
DIRECTION_CALLABLE=room_geometry:compute_room_direction
RECOMMENDATION_CALLABLE=recommend_service:recommend_for_room
# Optional, relative to backend root; defaults to bundled algorithm/.
# ALGORITHM_DIR=../algorithm
